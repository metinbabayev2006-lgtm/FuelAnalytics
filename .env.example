# Copy to .env and replace the placeholder before starting Docker Compose.
# Used only for the local development database.
POSTGRES_PASSWORD=replace_with_a_long_random_password
# Personal key; never commit a real key (including a provider demo key).
TANKERKOENIG_API_KEY=

# Optional personal archive access, used only by the local historical importer.
# Obtain your own access from Tankerkoenig; never share or commit real credentials.
TANKERKOENIG_ARCHIVE_USERNAME=
TANKERKOENIG_ARCHIVE_PASSWORD=
